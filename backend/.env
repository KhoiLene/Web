DB_HOST=db
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=techtra
DB_PORT=5432
PORT=5000

# ─── VNPay Sandbox ─────────────────────────────────────────────────────
# Đăng ký tại https://sandbox.vnpayment.vn/devreg/ để nhận credentials.
# (Trong Docker, host `db` thay vì `localhost`)
VNP_TMN_CODE=YOUR_TMN_CODE_HERE
VNP_HASH_SECRET=YOUR_HASH_SECRET_HERE
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost/components/thanh-toan/vnpay-return.html

# ─── Email SMTP (gửi thông báo đơn hàng) ─────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_NAME=Techtra
SMTP_FROM_EMAIL=your_email@gmail.com

# ─── Zalo OA ───────────────────────────────────────────────────────────
ZALO_APP_ID=your_zalo_app_id
ZALO_SECRET_KEY=your_zalo_secret_key
ZALO_ACCESS_TOKEN=your_zalo_access_token

# ─── Payment Poller ────────────────────────────────────────────────────
PAYMENT_POLLER_ENABLED=true
PAYMENT_POLLER_INTERVAL_MS=60000